<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-feature android:glEsVersion="0x00030001"/>
    <uses-feature android:name="android.hardware.vr.headtracking"  android:version="1" android:required="true" />
    <uses-permission android:name="android.permission.CAMERA"/>

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR" />
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM" />
    <uses-permission android:name="com.magicleap.permission.HAND_TRACKING" />
    <uses-permission android:name="com.magicleap.permission.EYE_TRACKING" />

    <!-- Android XR. The OpenXR runtime only creates hand trackers and eye gaze data when these
         runtime permissions are granted. Ignored by other AOSP devices. -->
    <uses-feature android:name="android.software.xr.api.openxr" android:version="0x00010001" android:required="false" />
    <uses-permission android:name="android.permission.HAND_TRACKING" />
    <uses-permission android:name="android.permission.EYE_TRACKING_FINE" />
    <!-- GeckoView takes a wake lock while media plays. Android XR enforces the permission and
         GeckoView crashes without it (the main manifest removes it). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" tools:node="replace" />

    <queries>
        <provider android:authorities="org.khronos.openxr.runtime_broker;org.khronos.openxr.system_runtime_broker"/>
    </queries>
    <application>
        <!-- Android XR: launch in Full Space as an OpenXR app instead of a 2D panel in Home Space,
             and give the app access to the system OpenXR runtime library. -->
        <property
            android:name="android.window.PROPERTY_XR_ACTIVITY_START_MODE"
            android:value="XR_ACTIVITY_START_MODE_FULL_SPACE_UNMANAGED" />
        <uses-native-library android:name="libopenxr.google.so" android:required="false" />
        <activity android:name=".VRBrowserActivity" android:screenOrientation="landscape">
            <meta-data android:name="android.app.lib_name" android:value="native-lib" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD" />
            </intent-filter>
        </activity>
    </application>
</manifest>
